{
  "name": "session",
  "description": "Start a long-running session: render once, then send JSON-line requests on stdin ({\"id\":1,\"action\":{\"tap\":{\"testID\":\"submit\"}}}, {\"id\":2,\"tree\":true}, {\"id\":3,\"quit\":true}) and read one JSON line per request on stdout. Use it for many actions on one app state without re-rendering.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tapMode": {
        "type": "string",
        "enum": [
          "touch",
          "click",
          "both"
        ]
      },
      "timeout": {
        "type": "number",
        "description": "Per-request timeout in ms."
      },
      "file": {
        "type": "string",
        "description": "Component file (default export or `App` named export)."
      },
      "preset": {
        "type": "string",
        "enum": [
          "android-phone",
          "ios-phone",
          "android-tablet",
          "ios-tablet"
        ],
        "description": "Device preset: platform, viewport, safe area insets, header height."
      },
      "platform": {
        "type": "string",
        "description": "Metro platform (`android`, `ios`, `a11ytree`, ...). Required unless a preset or a11y-tree.json sets it."
      },
      "width": {
        "type": "number",
        "description": "Viewport width in dp."
      },
      "height": {
        "type": "number",
        "description": "Viewport height in dp."
      },
      "safeAreaInsets": {
        "type": "object",
        "properties": {
          "top": {
            "type": "number"
          },
          "left": {
            "type": "number"
          },
          "right": {
            "type": "number"
          },
          "bottom": {
            "type": "number"
          }
        },
        "required": [
          "top",
          "left",
          "right",
          "bottom"
        ],
        "additionalProperties": false
      },
      "headerHeight": {
        "type": "number",
        "description": "react-native-screens native header height in dp."
      },
      "dev": {
        "type": "boolean",
        "description": "Development bundle (`__DEV__ = true`)."
      },
      "mounted": {
        "type": "boolean",
        "description": "Set false to skip mounted-view values (`visualBox`, `effectiveOpacity`)."
      }
    },
    "required": [
      "file"
    ],
    "definitions": {}
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SessionOutputLine",
    "anyOf": [
      {
        "$ref": "#/definitions/SessionReady"
      },
      {
        "$ref": "#/definitions/SessionResponse"
      }
    ],
    "description": "Any line on the session's stdout.",
    "definitions": {
      "SessionReady": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "ready": {
                "type": "boolean",
                "const": true
              },
              "tree": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/TreeNode"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "host": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "env",
                      "package",
                      "download",
                      "dist"
                    ]
                  },
                  "version": {
                    "type": "string"
                  },
                  "protocolVersion": {
                    "type": "number"
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false,
                "description": "Where the host came from; `version` / `protocolVersion` from its host-version.json when it has one."
              },
              "hostInfo": {
                "$ref": "#/definitions/HostRuntimeInfo",
                "description": "The host's own build info (getHostInfo)."
              },
              "logs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/LogEntry"
                }
              }
            },
            "required": [
              "ready",
              "tree",
              "capabilities"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ready": {
                "type": "boolean",
                "const": false
              },
              "error": {
                "$ref": "#/definitions/ErrorInfo"
              },
              "logs": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/LogEntry"
                }
              }
            },
            "required": [
              "ready",
              "error"
            ],
            "additionalProperties": false
          }
        ],
        "description": "First line on the session's stdout."
      },
      "TreeNode": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Id within one tree: `n0`, `n1`, ... in pre-order (changes when the tree changes)."
          },
          "key": {
            "type": "string",
            "description": "Stable key: `testID` when set, else `<parent key>/<type>:<n>` (n = index among siblings of the same type); the root is its type."
          },
          "type": {
            "type": "string",
            "description": "Host component name: `View`, `Paragraph`, `Image`, `Text` (text fragment, mounted source only), ..."
          },
          "sel": {
            "type": "string",
            "description": "Selector for this node. `#testID` when a testID is set, otherwise a path of types with 1-based sibling indices, e.g. `RootView>View>Paragraph:2`."
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Accessibility role: `role` prop, else `accessibilityRole`, else the component default; `null` if none."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Accessible name: label, else aria-label, else own text, else descendant text if accessible."
          },
          "a11y": {
            "$ref": "#/definitions/A11yInfo"
          },
          "box": {
            "$ref": "#/definitions/Box",
            "description": "On-screen frame in dp: sum of parent frames, minus the `contentOffset` of ancestor ScrollViews (`shadowTree` source)."
          },
          "style": {
            "type": "object",
            "additionalProperties": {},
            "description": "Other props reported by the host: visual style, flattened Yoga style, font props (Paragraph), component props (Image sources, TextInput placeholder, ...). Strings for the `mounted` source."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Text content (Paragraph, Text fragment, TextInput value), else `null`."
          },
          "testID": {
            "type": [
              "string",
              "null"
            ]
          },
          "virtual": {
            "type": "boolean",
            "description": "`true` when the host node has no frame of its own (nested `<Text>` span kept for its a11y props, or another virtual node). `box` is then the parent's box. Only for the `shadowTree` source."
          },
          "visualBox": {
            "$ref": "#/definitions/Box",
            "description": "Where the node is drawn, when it differs from `box`: the bounding box of the (mounted) frame after the transforms of the node and its ancestors (`shadowTree` source). Absent when there is no transform or mounted frame override on the path."
          },
          "effectiveOpacity": {
            "type": "number",
            "description": "Product of the node's and its ancestors' opacity (mounted opacity when the host reports one). Present only when below 1."
          },
          "expo": {
            "type": "object",
            "additionalProperties": {},
            "description": "Expo module views (`@expo/ui`, type `ExpoUI.<View>`): the props the view received (`modifiers` verbatim; modifier callbacks are `\"eventListener\": null`)."
          },
          "layout": {
            "type": "string",
            "enum": [
              "emulated",
              "placeholder"
            ],
            "description": "Expo module views: `emulated` when a SwiftUI/Compose layout engine (or the Host's content sizing) produced the frame, `placeholder` when no engine handled the subtree (the frame is not the drawn one). Hosts before the label change mark only the Host `emulated`."
          },
          "emulatedBy": {
            "$ref": "#/definitions/ExpoLayoutEngine",
            "description": "On an Expo Host: the engine that laid out its subtree."
          },
          "debugProps": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Raw debug props from the host; only with `--debug-props` and the `shadowTree` source."
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/TreeNode"
            }
          }
        },
        "required": [
          "ref",
          "key",
          "type",
          "sel",
          "role",
          "name",
          "a11y",
          "box",
          "style",
          "text",
          "testID",
          "children"
        ],
        "additionalProperties": false
      },
      "A11yInfo": {
        "type": "object",
        "properties": {
          "accessible": {
            "type": "boolean",
            "description": "`accessible` prop (or `true` for elements that are accessible by default)."
          },
          "label": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "state": {
            "$ref": "#/definitions/A11yState"
          },
          "hidden": {
            "type": "boolean",
            "description": "`importantForAccessibility` / `aria-hidden` / `accessibilityElementsHidden`."
          },
          "raw": {
            "type": "object",
            "additionalProperties": {},
            "description": "Raw accessibility-related props as reported by the host. Strings for the `mounted` source; typed values for the `shadowTree` source."
          }
        },
        "additionalProperties": false
      },
      "A11yState": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean"
          },
          "checked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "const": "mixed"
              }
            ]
          },
          "busy": {
            "type": "boolean"
          },
          "expanded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Box": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "Absolute position in the viewport, in dp."
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "ExpoLayoutEngine": {
        "type": "string",
        "enum": [
          "swiftui",
          "compose"
        ],
        "description": "Layout engine of an Expo Host (`emulatedBy`)."
      },
      "HostRuntimeInfo": {
        "type": "object",
        "properties": {
          "protocolVersion": {
            "type": "number",
            "description": "Version of the CLI <-> host contract; the CLI refuses unsupported ones (HOST_INCOMPATIBLE)."
          },
          "rnVersion": {
            "type": "string"
          },
          "buildType": {
            "type": "string"
          },
          "sanitize": {
            "type": "boolean"
          },
          "engines": {
            "type": "object",
            "properties": {
              "swiftui": {
                "type": "boolean"
              },
              "compose": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "fonts": {
            "type": "object",
            "properties": {
              "roboto": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "not": {}
                }
              ]
            }
          }
        },
        "required": [
          "protocolVersion"
        ],
        "additionalProperties": {},
        "description": "The host's build info (`NativeFantom.getHostInfo()`), or `{protocolVersion}` from a `protocolVersion:<n>` capability. Absent for hosts that report neither."
      },
      "LogEntry": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "known": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "level",
          "message"
        ],
        "additionalProperties": false
      },
      "ErrorInfo": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/definitions/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "USAGE",
          "CHECK_FAILED",
          "BUNDLE_FAILED",
          "APP_THREW",
          "TARGET_NOT_FOUND",
          "TARGET_COVERED",
          "TIMEOUT",
          "HOST_MISSING",
          "HOST_UNAVAILABLE",
          "HOST_INCOMPATIBLE",
          "HOST_CRASHED"
        ],
        "description": "Machine-readable errors: `{code, message, hint?, details?}`, with one exit code per class of failure.\n\n| exit | meaning | | --- | --- | | 0 | ok | | 1 | usage (bad arguments, script, selector) | | 2 | check failed (`check` command) | | 3 | bundle failed (Metro) | | 4 | app error (the app threw while loading or rendering) | | 5 | host (missing, unavailable, incompatible, crashed, timeout) |"
      },
      "SessionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/definitions/RequestId"
          },
          "ok": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/definitions/ErrorInfo"
          },
          "step": {
            "$ref": "#/definitions/Step"
          },
          "tree": {
            "anyOf": [
              {
                "$ref": "#/definitions/TreeNode"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/TreeNode"
                }
              },
              {
                "type": "object",
                "additionalProperties": {}
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              {
                "type": "string"
              }
            ],
            "description": "`tree` requests and `snapshot` actions: a TreeNode (`json`), a list of matches (`select`), compact nodes (`compact`), or a string (`text`, `ndjson`)."
          },
          "diff": {
            "$ref": "#/definitions/TreeDiff",
            "description": "Action requests with `diff: true`."
          },
          "fallbacks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/LogEntry"
            }
          }
        },
        "required": [
          "id",
          "ok"
        ],
        "additionalProperties": false,
        "description": "One line on the session's stdout per request."
      },
      "RequestId": {
        "type": [
          "string",
          "number",
          "null"
        ],
        "description": "Echoed in the response."
      },
      "Step": {
        "type": "object",
        "properties": {
          "index": {
            "type": "number"
          },
          "action": {
            "type": "string"
          },
          "target": {
            "anyOf": [
              {
                "$ref": "#/definitions/StepNode"
              },
              {
                "type": "null"
              }
            ],
            "description": "The node the action was aimed at (for coordinate taps: the hit node)."
          },
          "hit": {
            "anyOf": [
              {
                "$ref": "#/definitions/StepNode"
              },
              {
                "type": "null"
              }
            ],
            "description": "The node the host (or JS fallback) hit test found at the tap point."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Native events sent, in order (plus `wait <n>ms` markers; `gh:down` / `gh:move xN` / `gh:up` for pointer samples fed to react-native-gesture-handler)."
          },
          "gestureHandlers": {
            "type": "number",
            "description": "Number of react-native-gesture-handler handlers that received the pointer."
          },
          "via": {
            "type": "object",
            "properties": {
              "hitTest": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "native",
                  "js",
                  null
                ]
              },
              "events": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "native",
                  "js",
                  null
                ]
              }
            },
            "required": [
              "hitTest",
              "events"
            ],
            "additionalProperties": false,
            "description": "Which implementation was used: host methods (`native`) or the JS fallback (`js`)."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/definitions/StepError"
              }
            ],
            "description": "Runtime payloads carry a string; the CLI output has {code, message}."
          },
          "diff": {
            "$ref": "#/definitions/TreeDiff",
            "description": "With `run --diff` / session `diff: true`: changes made by this step."
          }
        },
        "required": [
          "index",
          "action",
          "target",
          "hit",
          "events"
        ],
        "additionalProperties": false
      },
      "StepNode": {
        "type": "object",
        "properties": {
          "tag": {
            "type": [
              "number",
              "null"
            ]
          },
          "ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable key (see TreeNode.key)."
          },
          "testID": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string"
          },
          "box": {
            "anyOf": [
              {
                "$ref": "#/definitions/Box"
              },
              {
                "type": "null"
              }
            ],
            "description": "Absolute box in dp; null when the host hit test found a node that is not in the tree."
          },
          "viaHitSlop": {
            "type": "boolean",
            "description": "Only on `hit` from the host hit test: the point was outside the node's frame but inside its hitSlop."
          }
        },
        "required": [
          "tag",
          "ref",
          "testID",
          "type",
          "box"
        ],
        "additionalProperties": false,
        "description": "One executed action of `run --script` (built in runtime/actions.js)."
      },
      "StepError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "TreeDiff": {
        "type": "object",
        "properties": {
          "added": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/NodeSummary"
            }
          },
          "removed": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/NodeSummary"
            }
          },
          "changed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "before": {
                  "type": "object",
                  "additionalProperties": {}
                },
                "after": {
                  "type": "object",
                  "additionalProperties": {}
                }
              },
              "required": [
                "key",
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "added",
          "removed",
          "changed"
        ],
        "additionalProperties": false
      },
      "NodeSummary": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "type"
        ],
        "additionalProperties": false
      }
    }
  },
  "examples": [
    {
      "input": {
        "file": "examples/basic/App.tsx",
        "platform": "android"
      },
      "argv": [
        "rn-a11y-tree",
        "session",
        "examples/basic/App.tsx",
        "--platform",
        "android"
      ]
    }
  ],
  "x-cli": {
    "command": "session",
    "outputSchemaFiles": [
      "schema/session-output-line.json"
    ],
    "note": "Output matches outputSchema with format \"json\" (the default). Errors: schema/error-output.json.",
    "exitCodes": {
      "0": "ok",
      "1": "USAGE",
      "2": "CHECK_FAILED",
      "3": "BUNDLE_FAILED",
      "4": "APP_THREW, TARGET_NOT_FOUND, TARGET_COVERED",
      "5": "TIMEOUT, HOST_MISSING, HOST_UNAVAILABLE, HOST_INCOMPATIBLE, HOST_CRASHED"
    }
  },
  "x-protocol": {
    "stdin": "one JSON request per line (schema/session-request.json)",
    "stdout": "a ready line, then one response line per request (schema/session-output-line.json)",
    "requestSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SessionRequest",
      "anyOf": [
        {
          "$ref": "#/definitions/SessionActionRequest"
        },
        {
          "$ref": "#/definitions/SessionTreeRequest"
        },
        {
          "$ref": "#/definitions/SessionQuitRequest"
        }
      ],
      "description": "One line on the session's stdin.",
      "definitions": {
        "SessionActionRequest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/definitions/RequestId"
            },
            "action": {
              "$ref": "#/definitions/Action"
            },
            "diff": {
              "type": "boolean"
            },
            "format": {
              "$ref": "#/definitions/Format"
            },
            "select": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "depth": {
              "type": "number"
            },
            "subtree": {
              "type": "string"
            },
            "style": {
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "id"
          ]
        },
        "RequestId": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "Echoed in the response."
        },
        "Action": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "tap": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Target"
                    },
                    {
                      "$ref": "#/definitions/Point"
                    }
                  ]
                }
              },
              "required": [
                "tap"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "longPress": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/Target"
                    },
                    {
                      "$ref": "#/definitions/Point"
                    }
                  ]
                }
