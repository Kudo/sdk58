      "props": {
       "name": "content"
      },
      "children": [
       {
        "type": "Text",
        "props": {
         "text": "First"
        },
        "modifiers": []
       }
      ]
     },
     {
      "type": "Slot",
      "props": {
       "name": "footer"
      },
      "children": [
