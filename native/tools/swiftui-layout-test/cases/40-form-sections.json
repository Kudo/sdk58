            },
            "modifiers": [
             {
              "$type": "tag",
              "tag": "a"
             }
            ]
           },
           {
            "type": "Text",
            "props": {
             "text": "Dark"
            },
            "modifiers": [
             {
              "$type": "tag",
              "tag": "b"
             }
            ]
           }
          ]
         }
        ]
       },
       {
        "type": "TextField",
        "props": {
         "placeholder": "Name"
        }
       }
      ]
