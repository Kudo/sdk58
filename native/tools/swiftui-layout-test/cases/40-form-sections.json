    }
   },
   {
    "type": "Section",
    "children": [
     {
      "type": "Slot",
      "props": {
       "name": "header"
      },
      "children": [
       {
        "type": "Text",
        "props": {
         "text": "Header slot"
        },
        "modifiers": []
       }
      ]
     },
