{
  "name": "query",
  "description": "Render a component and return only the nodes that match selectors (e.g. role=button, testID=submit, text~Sign), or one subtree. Smaller than a full render; use it to look up specific elements, their boxes and states.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "select": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Selectors `field=value` or `field~text` (testID, role, name, type, key, ref, sel, text), ANDed."
      },
      "subtree": {
        "type": "string",
        "description": "Start at the first node that matches this selector."
      },
      "depth": {
        "type": "number",
        "description": "Levels of children below each result (0 = the node only; the default with `select`)."
      },
      "format": {
        "$ref": "#/definitions/TreeFormat"
      },
      "style": {
        "type": "boolean"
      },
      "file": {
        "type": "string",
        "description": "Component file (default export or `App` named export)."
      },
      "setup": {
        "type": "string",
        "description": "Native fixture module loaded before the app."
      },
      "projectRoot": {
        "type": "string",
        "description": "Consuming app root for dependencies and project settings."
      },
      "metroConfig": {
        "type": "string",
        "description": "Explicit Metro config file; supported projection only, persistent caches disabled."
      },
      "timeout": {
        "type": "number",
        "description": "Host execution deadline in milliseconds after bundling (default 30000); session applies it per host frame and response write."
      },
      "noStderr": {
        "type": "boolean",
        "description": "Suppress all stderr output, including warnings, errors, verbose logs and timings."
      },
      "preset": {
        "type": "string",
        "enum": [
          "android-phone",
          "ios-phone",
          "android-tablet",
          "ios-tablet"
        ],
        "description": "Device preset: platform, viewport, safe area insets, header height."
      },
      "platform": {
        "type": "string",
        "description": "Metro platform (`android`, `ios`, `a11ytree`, ...). Required unless a preset or a11y-tree.json sets it."
      },
      "width": {
        "type": "number",
        "description": "Viewport width in dp."
      },
      "height": {
        "type": "number",
        "description": "Viewport height in dp."
      },
      "safeAreaInsets": {
        "type": "object",
        "properties": {
          "top": {
            "type": "number"
          },
          "left": {
            "type": "number"
          },
          "right": {
            "type": "number"
          },
          "bottom": {
            "type": "number"
          }
        },
        "required": [
          "top",
          "left",
          "right",
          "bottom"
        ],
        "additionalProperties": false
      },
      "headerHeight": {
        "type": "number",
        "description": "react-native-screens native header height in dp."
      },
      "scale": {
        "type": "number",
        "description": "Device pixel ratio (Dimensions/PixelRatio); default: preset, else 3."
      },
      "fontScale": {
        "type": "number",
        "description": "Font scale (Dimensions/PixelRatio); default 1."
      },
      "dev": {
        "type": "boolean",
        "description": "Development bundle (`__DEV__ = true`)."
      },
      "mounted": {
        "type": "boolean",
        "description": "Set false to skip mounted-view values (`visualBox`, `effectiveOpacity`)."
      },
      "failOnFallback": {
        "type": "boolean",
        "description": "Reject unapproved native/runtime fallbacks (exit 6)."
      },
      "allowFallback": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Exact fallback names approved for this test; unsupported API calls are always rejected."
      }
    },
    "required": [
      "file"
    ],
    "definitions": {
      "TreeFormat": {
        "type": "string",
        "enum": [
          "json",
          "compact",
          "text",
          "ndjson"
        ]
      }
    }
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "anyOf": [
      {
        "title": "QueryResult",
        "type": "object",
        "properties": {
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "source": {
            "$ref": "#/definitions/TreeSource"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/TreeNode"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Diagnostic"
            }
          },
          "logs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/LogEntry"
            }
          }
        },
        "required": [
          "viewport",
          "source",
          "matches"
        ],
        "additionalProperties": false,
        "description": "`render --select ...` (JSON format): the matching nodes."
      },
      {
        "title": "RenderResult",
        "type": "object",
        "properties": {
          "viewport": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "source": {
            "$ref": "#/definitions/TreeSource"
          },
          "root": {
            "$ref": "#/definitions/TreeNode"
          },
          "hostInfo": {
            "$ref": "#/definitions/HostRuntimeInfo"
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Diagnostic"
            },
            "description": "App console output (only when there was any); `known: true` marks common React Native noise."
          },
          "logs": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/LogEntry"
            }
          }
        },
        "required": [
          "viewport",
          "source",
          "root"
        ],
        "additionalProperties": false
      }
    ],
    "definitions": {
      "TreeSource": {
        "type": "string",
        "enum": [
          "shadowTree",
          "mounted"
        ],
        "description": "Where the tree comes from:\n- `shadowTree`: the host's `getA11yTree` (committed ShadowTree, full   hierarchy, typed values).\n- `mounted`: Fantom's `getRenderedOutput` (mounted views after view   flattening, debug-string props)."
      },
      "TreeNode": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "Id within one tree: `n0`, `n1`, ... in pre-order (changes when the tree changes)."
          },
          "key": {
            "type": "string",
            "description": "Stable key: `testID` when set, else `<parent key>/<type>:<n>` (n = index among siblings of the same type); the root is its type."
          },
          "type": {
            "type": "string",
            "description": "Host component name: `View`, `Paragraph`, `Image`, `Text` (text fragment, mounted source only), ..."
          },
          "sel": {
            "type": "string",
            "description": "Selector for this node. `#testID` when a testID is set, otherwise a path of types with 1-based sibling indices, e.g. `RootView>View>Paragraph:2`."
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "description": "Accessibility role: `role` prop, else `accessibilityRole`, else the component default; `null` if none."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Accessible name: label, else aria-label, else own text, else descendant text if accessible."
          },
          "a11y": {
            "$ref": "#/definitions/A11yInfo"
          },
          "box": {
            "$ref": "#/definitions/Box",
            "description": "On-screen frame in dp: sum of parent frames, minus the `contentOffset` of ancestor ScrollViews (`shadowTree` source)."
          },
          "style": {
            "type": "object",
            "additionalProperties": {},
            "description": "Other props reported by the host: visual style, flattened Yoga style, font props (Paragraph), component props (Image sources, TextInput placeholder, ...). Strings for the `mounted` source."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Text content (Paragraph, Text fragment, TextInput value), else `null`."
          },
          "testID": {
            "type": [
              "string",
              "null"
            ]
          },
          "virtual": {
            "type": "boolean",
            "description": "`true` when the host node has no frame of its own (nested `<Text>` span kept for its a11y props, or another virtual node). `box` is then the parent's box. Only for the `shadowTree` source."
          },
          "visualBox": {
            "$ref": "#/definitions/Box",
            "description": "Where the node is drawn, when it differs from `box`: the bounding box of the (mounted) frame after the transforms of the node and its ancestors (`shadowTree` source). Absent when there is no transform or mounted frame override on the path."
          },
          "effectiveOpacity": {
            "type": "number",
            "description": "Product of the node's and its ancestors' opacity (mounted opacity when the host reports one). Present only when below 1."
          },
          "expo": {
            "type": "object",
            "additionalProperties": {},
            "description": "Expo module views (`@expo/ui`, type `ExpoUI.<View>`): the props the view received (`modifiers` verbatim; modifier callbacks are `\"eventListener\": null`)."
          },
          "layout": {
            "type": "string",
            "enum": [
              "emulated",
              "placeholder"
            ],
            "description": "Expo module views: `emulated` when a SwiftUI/Compose layout engine (or the Host's content sizing) produced the frame, `placeholder` when no engine handled the subtree (the frame is not the drawn one). Hosts before the label change mark only the Host `emulated`."
          },
          "emulatedBy": {
            "$ref": "#/definitions/ExpoLayoutEngine",
            "description": "On an Expo Host: the engine that laid out its subtree."
          },
          "debugProps": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Raw debug props from the host; only with `--debug-props` and the `shadowTree` source."
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/TreeNode"
            }
          }
        },
        "required": [
          "ref",
          "key",
          "type",
          "sel",
          "role",
          "name",
          "a11y",
          "box",
          "style",
          "text",
          "testID",
          "children"
        ],
        "additionalProperties": false
      },
      "A11yInfo": {
        "type": "object",
        "properties": {
          "accessible": {
            "type": "boolean",
            "description": "`accessible` prop (or `true` for elements that are accessible by default)."
          },
          "label": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "state": {
            "$ref": "#/definitions/A11yState"
          },
          "hidden": {
            "type": "boolean",
            "description": "`importantForAccessibility` / `aria-hidden` / `accessibilityElementsHidden`."
          },
          "raw": {
            "type": "object",
            "additionalProperties": {},
            "description": "Raw accessibility-related props as reported by the host. Strings for the `mounted` source; typed values for the `shadowTree` source."
          }
        },
        "additionalProperties": false
      },
      "A11yState": {
        "type": "object",
        "properties": {
          "disabled": {
            "type": "boolean"
          },
          "selected": {
            "type": "boolean"
          },
          "checked": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "const": "mixed"
              }
            ]
          },
          "busy": {
            "type": "boolean"
          },
          "expanded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Box": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "description": "Absolute position in the viewport, in dp."
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      },
      "ExpoLayoutEngine": {
        "type": "string",
        "enum": [
          "swiftui",
          "compose"
        ],
        "description": "Layout engine of an Expo Host (`emulatedBy`)."
      },
      "Diagnostic": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "BUILD_CONFIGURATION",
              "DEPENDENCY_COMPATIBILITY",
              "APPLICATION_FIXTURE",
              "NATIVE_MODULE_FALLBACK",
              "NATIVE_COMPONENT_FALLBACK",
              "NATIVE_API_UNSUPPORTED",
              "RUNTIME_FALLBACK"
            ]
          },
          "target": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "target",
          "message"
        ],
        "additionalProperties": false,
        "description": "Observed limitations, not a certificate of native equivalence when empty."
      },
      "LogEntry": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "known": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "level",
          "message"
        ],
        "additionalProperties": false
      },
      "HostRuntimeInfo": {
        "type": "object",
        "properties": {
          "protocolVersion": {
            "type": "number",
            "description": "Version of the CLI <-> host contract; the CLI refuses unsupported ones (HOST_INCOMPATIBLE)."
          },
          "rnVersion": {
            "type": "string"
          },
          "buildType": {
            "type": "string"
          },
          "sanitize": {
            "type": "boolean"
          },
          "engines": {
            "type": "object",
            "properties": {
              "swiftui": {
                "type": "boolean"
              },
              "compose": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "fonts": {
            "type": "object",
            "properties": {
              "roboto": {
                "type": "boolean"
              }
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "not": {}
                }
              ]
            }
          },
          "textLayout": {
            "type": "string",
            "enum": [
              "macos",
              "portable",
              "stub"
            ],
            "description": "Text measurement: `macos` (CoreText), `portable` (embedded fonts, any OS) or `stub` (no text sizes)."
          }
        },
        "required": [
          "protocolVersion"
        ],
        "additionalProperties": {},
        "description": "The host's build info (`NativeFantom.getHostInfo()`), or `{protocolVersion}` from a `protocolVersion:<n>` capability. Absent for hosts that report neither."
      }
    }
  },
  "examples": [
    {
      "input": {
        "file": "examples/basic/App.tsx",
        "platform": "android",
        "select": [
          "role=button"
        ],
        "format": "text"
      },
      "argv": [
        "rn-a11y-tree",
        "render",
        "examples/basic/App.tsx",
        "--platform",
        "android",
        "--select",
        "role=button",
        "--format",
        "text"
      ]
    }
  ],
  "x-cli": {
    "command": "render",
    "outputSchemaFiles": [
      "schema/query-result.json",
      "schema/render-result.json"
    ],
    "note": "Output matches outputSchema with explicit --format json. Piped render/run output defaults to text. Errors: schema/error-output.json.",
    "exitCodes": {
      "0": "ok",
      "1": "USAGE",
      "2": "CHECK_FAILED, EXPECT_FAILED",
      "3": "BUNDLE_FAILED",
      "4": "APP_THREW, TARGET_NOT_FOUND, TARGET_COVERED, TARGET_ZERO_SIZE",
      "5": "TIMEOUT, HOST_MISSING, HOST_UNAVAILABLE, HOST_INCOMPATIBLE, HOST_CRASHED",
      "6": "UNSUPPORTED_NATIVE"
    }
  }
}
