{
  "name": "check",
  "description": "Render a component (optionally after actions) and check accessibility and design rules: accessible names, touch target size, focusable elements in hidden subtrees, text contrast (WCAG), and design tokens (colors, spacing grid, fonts, font sizes). Returns per-node results and a list of violations; ok=false (exit code 2) when a rule fails.",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rules": {
        "$ref": "#/definitions/Rules",
        "description": "The rules; default: `rules` in a11y-tree.json."
      },
      "actions": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/Action"
        },
        "description": "Run these actions first and check the final tree."
      },
      "tapMode": {
        "type": "string",
        "enum": [
          "touch",
          "click",
          "both"
        ]
      },
      "subtree": {
        "type": "string",
        "description": "Check only this subtree."
      },
      "format": {
        "type": "string",
        "enum": [
          "json",
          "text"
        ]
      },
      "file": {
        "type": "string",
        "description": "Component file (default export or `App` named export)."
      },
      "setup": {
        "type": "string",
        "description": "Native fixture module loaded before the app."
      },
      "projectRoot": {
        "type": "string",
        "description": "Consuming app root for dependencies and project settings."
      },
      "metroConfig": {
        "type": "string",
        "description": "Explicit Metro config file; supported projection only, persistent caches disabled."
      },
      "timeout": {
        "type": "number",
        "description": "Host execution deadline in milliseconds after bundling (default 30000); session applies it per host frame and response write."
      },
      "noStderr": {
        "type": "boolean",
        "description": "Suppress all stderr output, including warnings, errors, verbose logs and timings."
      },
      "preset": {
        "type": "string",
        "enum": [
          "android-phone",
          "ios-phone",
          "android-tablet",
          "ios-tablet"
        ],
        "description": "Device preset: platform, viewport, safe area insets, header height."
      },
      "platform": {
        "type": "string",
        "description": "Metro platform (`android`, `ios`, `a11ytree`, ...). Required unless a preset or a11y-tree.json sets it."
      },
      "width": {
        "type": "number",
        "description": "Viewport width in dp."
      },
      "height": {
        "type": "number",
        "description": "Viewport height in dp."
      },
      "safeAreaInsets": {
        "type": "object",
        "properties": {
          "top": {
            "type": "number"
          },
          "left": {
            "type": "number"
          },
          "right": {
            "type": "number"
          },
          "bottom": {
            "type": "number"
          }
        },
        "required": [
          "top",
          "left",
          "right",
          "bottom"
        ],
        "additionalProperties": false
      },
      "headerHeight": {
        "type": "number",
        "description": "react-native-screens native header height in dp."
      },
      "scale": {
        "type": "number",
        "description": "Device pixel ratio (Dimensions/PixelRatio); default: preset, else 3."
      },
      "fontScale": {
        "type": "number",
        "description": "Font scale (Dimensions/PixelRatio); default 1."
      },
      "dev": {
        "type": "boolean",
        "description": "Development bundle (`__DEV__ = true`)."
      },
      "mounted": {
        "type": "boolean",
        "description": "Set false to skip mounted-view values (`visualBox`, `effectiveOpacity`)."
      },
      "failOnFallback": {
        "type": "boolean",
        "description": "Reject unapproved native/runtime fallbacks (exit 6)."
      },
      "allowFallback": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Exact fallback names approved for this test; unsupported API calls are always rejected."
      }
    },
    "required": [
      "file"
    ],
    "definitions": {
      "Rules": {
        "type": "object",
        "properties": {
          "names": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
