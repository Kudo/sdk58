                    }
                  },
                  "min": {
                    "type": "number"
                  },
                  "minLarge": {
                    "type": "number"
                  }
                }
              }
            ],
            "description": "Text contrast ratio (WCAG 2.x) at least `min` (default 4.5); `minLarge` for large text."
          },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ignore": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "colors": {
