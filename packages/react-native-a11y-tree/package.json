{
  "name": "react-native-a11y-tree",
  "version": "0.1.7",
  "description": "Render a React Native component headlessly (real Metro + Fabric/Hermes) and print its accessibility and layout tree; interact with it and check a11y/design rules. For agents and CI.",
  "keywords": [
    "react-native",
    "accessibility",
    "a11y",
    "fabric",
    "hermes",
    "metro",
    "expo",
    "testing",
    "headless",
    "agent",
    "layout"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Kudo/react-native-a11y-tree#readme",
  "bugs": {
    "url": "https://github.com/Kudo/react-native-a11y-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/react-native-a11y-tree"
  },
  "type": "module",
  "bin": {
    "rn-a11y-tree": "./dist/rn-a11y-tree.js"
  },
  "exports": {
    "./test": {"types": "./dist/types/testing.d.ts", "import": "./dist/test.js"},
    "./package.json": "./package.json"
  },
  "files": [
    "dist/rn-a11y-tree.js",
    "dist/test.js",
    "dist/test-config.js",
    "dist/types/",
    "runtime/",
    "!runtime/tsconfig.json",
    "schema/",
    "skill/",
    "tools/",
    "README.md",
    "LICENSE",
    "!dist/release",
    "!**/*.tgz",
    "!**/*.tar.gz"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "expo": ">=58.0.0",
    "react": "*",
    "react-native": ">=0.88.0-rc.2"
  },
  "dependencies": {
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "@react-native-a11y-tree/runtime-darwin-universal": "0.1.7",
    "@react-native-a11y-tree/runtime-linux-x64-gnu": "0.1.7",
    "@react-native-a11y-tree/runtime-win32-x64-msvc": "0.1.7"
  },
  "scripts": {
    "build": "bun ../../scripts/build.ts",
    "schema": "bun src/genSchema.ts",
    "prepack": "bun run build && bun run schema --check"
  }
}
