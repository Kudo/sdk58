{
  "name": "rn-a11y-host",
  "version": "0.1.1",
  "description": "Prebuilt headless React Native host (Fantom: Fabric + Hermes + Yoga) used by react-native-a11y-tree. macOS arm64 in 0.1.0.",
  "keywords": [
    "react-native",
    "fantom",
    "fabric",
    "hermes",
    "headless",
    "accessibility",
    "react-native-a11y-tree"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Kudo/react-native-a11y-tree/tree/main/packages/rn-a11y-host#readme",
  "bugs": {
    "url": "https://github.com/Kudo/react-native-a11y-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/rn-a11y-host"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./host-version.json": "./host-version.json",
    "./package.json": "./package.json"
  },
  "files": [
    "osx-bin/",
    "linux64-bin/",
    "win64-bin/",
    "host-version.json",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"const f='osx-bin/rn-a11y-host';if(!require('fs').existsSync(f)){console.error('rn-a11y-host: '+f+' is missing: run node scripts/release-host.mjs --pack in the repo root first');process.exit(1)}\""
  }
}
