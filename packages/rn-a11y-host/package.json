{
  "name": "rn-a11y-host",
  "version": "0.1.1",
  "description": "Resolver for platform-specific prebuilt React Native hosts used by react-native-a11y-tree.",
  "keywords": [
    "react-native",
    "fantom",
    "fabric",
    "hermes",
    "headless",
    "accessibility",
    "react-native-a11y-tree"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Kudo/react-native-a11y-tree/tree/main/packages/rn-a11y-host#readme",
  "bugs": {
    "url": "https://github.com/Kudo/react-native-a11y-tree/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/rn-a11y-host"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./host-version.json": "./host-version.json",
    "./package.json": "./package.json"
  },
  "files": [
    "host-version.json",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"for(const f of ['index.js','index.d.ts','host-version.json'])require('fs').accessSync(f)\""
  },
  "optionalDependencies": {
    "rn-a11y-host-darwin": "0.1.1",
    "rn-a11y-host-linux-x64": "0.1.1",
    "rn-a11y-host-win32-x64": "0.1.1"
  }
}
