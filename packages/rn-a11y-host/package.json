{
  "name": "rn-a11y-host",
  "version": "0.1.0",
  "description": "Prebuilt headless React Native host (Fantom: Fabric + Hermes) for react-native-a11y-tree",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
