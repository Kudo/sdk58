{
  "name": "@react-native-a11y-tree/runtime-win32-x64-msvc",
  "version": "0.1.5",
  "description": "Prebuilt React Native host for win32 (x64).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/runtime-win32-x64-msvc"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "win64-bin/rn-a11y-host.exe",
    "host-version.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"for(const f of ['win64-bin/rn-a11y-host.exe','host-version.json'])require('fs').accessSync(f)\""
  }
}
