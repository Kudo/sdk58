{
  "name": "@react-native-a11y-tree/runtime-darwin-universal",
  "version": "0.1.1",
  "description": "Prebuilt React Native host for darwin (arm64, x64).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/runtime-darwin-universal"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "files": [
    "osx-bin/rn-a11y-host",
    "host-version.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"for(const f of ['osx-bin/rn-a11y-host','host-version.json'])require('fs').accessSync(f)\""
  }
}
