{
  "name": "@react-native-a11y-tree/runtime-linux-x64-gnu",
  "version": "0.1.1",
  "description": "Prebuilt React Native host for linux (x64).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kudo/react-native-a11y-tree.git",
    "directory": "packages/runtime-linux-x64-gnu"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "files": [
    "linux64-bin/rn-a11y-host",
    "host-version.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node -e \"for(const f of ['linux64-bin/rn-a11y-host','host-version.json'])require('fs').accessSync(f)\""
  },
  "libc": [
    "glibc"
  ]
}
